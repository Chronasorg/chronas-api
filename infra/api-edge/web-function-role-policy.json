{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Tables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-west-1:937826731833:table/chronas-*",
        "arn:aws:dynamodb:eu-west-1:937826731833:table/chronas-*/index/*"
      ]
    },
    {
      "Sid": "StatisticsObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::chronas-frontend-new/api/statistics.json"
    },
    {
      "Sid": "StatisticsListOnlyItsKey",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::chronas-frontend-new",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "api/statistics.json"
        }
      }
    },
    {
      "Sid": "JwtSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:eu-west-1:937826731833:secret:/chronas/secrets-YDUZQG"
    },
    {
      "Sid": "JwtSecretParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-west-1:937826731833:parameter/chronas/jwt-secret"
    },
    {
      "Sid": "InvalidateApiEdge",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::937826731833:distribution/E1KTIK2H0W8J2Q"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-1:937826731833:log-group:/aws/lambda/web/chronas-api:*",
        "arn:aws:logs:*:937826731833:log-group:/aws/lambda/web/chronas-api.local:*"
      ]
    }
  ]
}
