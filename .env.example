# Chronas API Environment Configuration
#
# Local development uses a `.env` file (gitignored). The Lambda Web Function
# keeps no secret in its environment: config/bootstrap.js loads JWT_SECRET at
# startup from SSM Parameter Store when JWT_SECRET_PARAMETER names a
# SecureString parameter, otherwise from the AWS Secrets Manager secret named
# by SECRET_CONFIG_NAME (its JWT_SECRET field). The stored value wins over
# JWT_SECRET below.

# --- Required ---

# JWT signing secret. Required in all environments.
JWT_SECRET=your-super-secret-jwt-key-change-this

# --- Application ---

NODE_ENV=development
PORT=4040

# --- AWS ---

# Region the AWS SDK clients use. Defaults to eu-west-1 if unset.
AWS_REGION=eu-west-1

# --- DynamoDB feature flags ---
# All defaults to true; set to false locally only if you need to disable
# a specific table during debugging.
USE_DYNAMODB_AREAS=true
USE_DYNAMODB_MARKERS=true
USE_DYNAMODB_METADATA=true
USE_DYNAMODB_USERS=true
USE_DYNAMODB_FLAGS=true
USE_DYNAMODB_REVISIONS=true
USE_DYNAMODB_BOARD=true
DYNAMODB_TABLE_PREFIX=chronas

# --- CORS ---
# All https://*.chronas.org subdomains are allowed automatically by regex.
# Use ALLOWED_ORIGINS to add extra non-chronas.org origins (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
# Public frontend host.
CHRONAS_HOST=https://chronas.org

# --- Image hosting / payment / RUM (optional) ---

CLOUDINARY_URL=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

RUMENDPOINT=
RUMROLEARN=
RUMIDENTITYPOOL=
RUMAPPLICATIONID=
